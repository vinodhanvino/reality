# API base URL (empty = same origin)
VITE_API_BASE_URL=

# Dev proxy target used when VITE_API_BASE_URL is empty
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8088

# SessionStorage key for persisted auth (Zustand persist)
VITE_AUTH_STORAGE_KEY=spirix_auth_token

# Dev only: skip login when true (ProtectedRoute allows access)
VITE_DEV_AUTH_BYPASS=false
